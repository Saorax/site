---
import Layout from "../../../layouts/Layout.astro";
import LegendPage from "../../../components/game/LegendPage.jsx";
const { bioName } = Astro.params;
import { host } from "../../../stuff";
const legends = await fetch(`${host}/game/legends/summary`).then(r => r.json())
function normalizeString(input: string): string {
  return String(input || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase();
}
const normalizedBioName = normalizeString(bioName);
const legendSummary = legends.find((item) => normalizeString(item?.bio?.name?.normal) == normalizedBioName || normalizeString(item?.codeName) == normalizedBioName);
const legend = legendSummary
  ? await fetch(`${host}/game/legends/${encodeURIComponent(legendSummary.id)}`).then(r => r.ok ? r.json() : null)
  : null;
const currentIndex = legendSummary ? legends.findIndex(item => String(item?.id) === String(legendSummary?.id)) : -1;
const prevLegends = currentIndex >= 0 ? legends.slice(Math.max(currentIndex - 2, 0), currentIndex) : [];
const nextLegends = currentIndex >= 0 ? legends.slice(currentIndex + 1, currentIndex + 3) : [];
---

<Layout title={legend?.bio?.name?.normal || "Legend"}>
  <LegendPage client:load legend={legend} prevLegends={prevLegends} nextLegends={nextLegends} />
</Layout>
