---
import Layout from "../../layouts/Layout.astro";
import GameDatabase from '../../layouts/Game.jsx';
import { LoadingState, PageHeader, PageShell } from "../../components/ui/index.js";
import { RAW_METADATA, databasePageTitle, selectionFromParams } from '../../components/game/database/pages.js';
import { toolText } from '../../data/head.js';
const selection = selectionFromParams(Astro.url.searchParams);
const page = selection.category === RAW_METADATA ? RAW_METADATA : selection.subcategory;
---
<Layout title={databasePageTitle(selection)} description={toolText('/game/database')}>
    <GameDatabase client:only="react">
      <PageShell slot="fallback">
        <PageHeader title={page} />
        <LoadingState label="Loading…" />
      </PageShell>
    </GameDatabase>
</Layout>
