---
import Layout from '../layouts/Layout.astro';
import FindForms from '../components/FindForms.astro';
import { sections } from '../data/sections.js';
import { pageSuggestions } from '../data/not-found.js';

let path = Astro.url.pathname;
try { path = decodeURI(path); } catch {}
const suggestions = pageSuggestions(path);
Astro.response.status = 404;
---
<Layout title="Page Not Found" description="Page not found." noindex>
  <div class="grid gap-3 p-2 sm:p-3 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:items-start">
    <section class="rounded-2xl border border-slate-700 bg-slate-900 p-3">
      <div class="text-xs font-bold uppercase tracking-wide text-blue-300">404</div>
      <h1 class="mt-1 text-2xl font-bold text-white">Page not found</h1>
      <p class="mt-1 break-all font-mono text-sm text-slate-400">{path}</p>
      {suggestions.length > 0 && (
        <div class="mt-3">
          <h2 class="text-xs font-bold uppercase tracking-wide text-slate-400">Did you mean</h2>
          <ul class="mt-1 grid gap-1">
            {suggestions.map((page) => (
              <li><a href={page.href} class="flex items-baseline justify-between gap-2 rounded-xl border border-slate-700 bg-slate-950/60 px-3 py-2 text-sm font-bold text-blue-300 hover:border-blue-400"><span>{page.title}</span><span class="truncate font-mono text-xs font-normal text-slate-500">{page.href}</span></a></li>
            ))}
          </ul>
        </div>
      )}
      <div class="mt-3">
        <h2 class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-400">Search</h2>
        <FindForms />
      </div>
    </section>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {sections.map((section) => (
        <section class="rounded-2xl border border-slate-700 bg-slate-900 p-3">
          <h2 class="text-lg font-bold"><a href={section.href} class="text-white hover:text-blue-300">{section.title}</a></h2>
          <ul class="mt-2 grid gap-1 min-[112.5rem]:grid-cols-2">
            {[...section.tools, ...(section.navExtra ?? []).map((link) => ({ title: link.label, href: link.href }))].map((tool) => (
              <li><a href={tool.href} class="block rounded-lg px-2 py-1 text-sm font-bold text-slate-200 hover:bg-slate-800 hover:text-white">{tool.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>
