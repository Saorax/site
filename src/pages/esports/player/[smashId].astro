---
import Layout from '../../../layouts/Layout.astro';
import { PageShell, Empty } from '../../../components/esports/ui.jsx';
import { host } from '../../../stuff';

const reference = Astro.params.smashId ?? '';

async function byStartggId(id) {
  try {
    const response = await fetch(`${host}/v2/esports/players/by-provider/startgg/${encodeURIComponent(id)}`);
    return response.ok ? await response.json() : null;
  } catch {
    return null;
  }
}

let player = /^\d+$/.test(reference) ? await byStartggId(reference) : null;
if (!player) {
  try {
    const response = await fetch(`${host}/player/user/${encodeURIComponent(reference)}`);
    const user = response.ok ? await response.json() : null;
    if (user?.id) player = await byStartggId(String(user.id));
  } catch {}
}
if (player?.player_id) return Astro.redirect(`/esports/player/id/${player.player_id}${Astro.url.search}`, 301);
---
<Layout title="Player not found · Brawlhalla Esports">
  <PageShell back={{ href: '/esports/player', label: 'Players' }}>
    <Empty>
      This player isn't in the esports database yet.
      <a href={`/esports/player?search=${encodeURIComponent(reference)}`} class="ml-1 text-blue-500 hover:underline">Search players</a>
    </Empty>
  </PageShell>
</Layout>
