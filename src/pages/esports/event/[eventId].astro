---
import Layout from '../../../layouts/Layout.astro';
import { EventPage } from '../../../components/esports/TournamentPages.jsx';
import { fetchPageHead } from '../../../data/head.js';
const eventId = Number.parseInt(Astro.params.eventId ?? '', 10);
if (!Number.isSafeInteger(eventId) || eventId <= 0) return Astro.redirect('/esports/tournaments', 302);
const { head, missing } = await fetchPageHead('event', eventId);
if (missing) Astro.response.status = 404;
---
<Layout
  title={head?.title ?? (missing ? 'Event not found' : 'Brawlhalla Tournament Event')}
  description={head?.description ?? 'Brawlhalla event results, bracket and matches.'}
  image={head?.image ?? undefined}
  imageAlt={head?.name}
  imageWide={head?.imageWide}
>
  <EventPage client:load eventId={eventId} heading={head?.title} />
</Layout>
