---
import "../styles/global.css";
export interface Props {
  title: string;
}

const { title } = Astro.props as Props;

import StartGGAuth from "../components/auth/butt.jsx";

const gameLinks = [
  { label: "Game Database", href: "/game/database" },
  { label: "Legends", href: "/game/legends" },
  { label: "Animation Viewer", href: "/game/anim" },
  { label: "Map Viewer", href: "/game/maps" },
  { label: "Patch History", href: "/game/patch" },
  { label: "Color Scheme Creator", href: "/game/colors" },
];
const competitiveLinks = [
  { label: "Power Rankings", href: "/pr" },
  { label: "Esports Database", href: "/esports" },
];
const siteLinks = [{ label: "Changelog", href: "/changelog" }];
const gameActive = Astro.url.pathname.startsWith("/game");
const competitiveActive = title === "Power Rankings" || title === "eSports Database";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/asuri.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      .svg-container {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .svg-container svg {
        max-width: 100%;
        max-height: 100%;
      }
    </style>
  </head>
  <body class="min-h-screen bg-gray-100 text-slate-950 dark:bg-slate-950 dark:text-white">
  <nav class="sticky top-0 z-[100] select-none border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
    <div class="mx-auto max-w-[120rem] px-2 sm:px-4 lg:px-6">
      <div class="relative flex h-16 items-center justify-between gap-3">
        <div class="flex items-center sm:hidden">
          <button
            id="hamburger-button"
            type="button"
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-slate-100 p-2 text-slate-600 hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <svg
              class="block h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="hidden h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="flex min-w-0 flex-1 items-center justify-center sm:justify-start">
          <a href="/" class="flex items-center gap-2 rounded-xl px-2 py-1 text-slate-950 transition hover:bg-slate-100 dark:text-white dark:hover:bg-slate-900">
            <img class="h-9 w-9 object-contain" src="/asuri.png" alt="Saorax" />
            <span class="hidden text-base font-black sm:block">Saorax</span>
          </a>
          <div class="ml-3 hidden items-center gap-1 sm:flex">
            <a href="/" class:list={["rounded-xl px-3 py-2 text-sm font-black transition", title === "Home" ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Home</a>
            <details class="group relative">
              <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black transition marker:hidden", gameActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Game</summary>
              <div class="absolute left-0 top-full mt-2 grid w-64 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {gameLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
            <details class="group relative">
              <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black transition marker:hidden", competitiveActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Competitive</summary>
              <div class="absolute left-0 top-full mt-2 grid w-56 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {competitiveLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
            <details class="group relative">
              <summary class="flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black text-slate-700 transition marker:hidden hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900">More</summary>
              <div class="absolute left-0 top-full mt-2 grid w-48 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {siteLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
          </div>
        </div>
        <StartGGAuth client:load />
      </div>
    </div>
  </nav>
  <div class="hidden select-none border-b border-slate-200 bg-white shadow-lg dark:border-slate-800 dark:bg-slate-950 sm:hidden" id="mobile-menu">
    <div class="grid gap-2 p-3">
      <a href="/" class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-800 dark:bg-slate-900 dark:text-white">Home</a>
      <details class="rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer list-none px-3 py-2 text-sm font-black marker:hidden">Game</summary>
        <div class="grid gap-1 border-t border-slate-200 p-2 dark:border-slate-800">{gameLinks.map((link) => <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-blue-500 hover:text-white">{link.label}</a>)}</div>
      </details>
      <details class="rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer list-none px-3 py-2 text-sm font-black marker:hidden">Competitive</summary>
        <div class="grid gap-1 border-t border-slate-200 p-2 dark:border-slate-800">{competitiveLinks.map((link) => <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-blue-500 hover:text-white">{link.label}</a>)}</div>
      </details>
      {siteLinks.map((link) => <a href={link.href} class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-800 dark:bg-slate-900 dark:text-white">{link.label}</a>)}
    </div>
  </div>
    <main class="min-h-[calc(100dvh-4rem)] bg-gray-100 text-slate-950 dark:bg-slate-950 dark:text-white">
      <slot />
    </main>
    <script>
      const hamburger = document.getElementById("hamburger-button");
      const mobileMenu = document.getElementById("mobile-menu");
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>("nav details, #mobile-menu details"));

      hamburger?.addEventListener("click", function () {
          var menu = document.getElementById("mobile-menu");
          if (!menu) return;
          if (menu.classList.contains("hidden")) {
            menu.classList.remove("hidden");
            this.setAttribute("aria-expanded", "true");
          } else {
            menu.classList.add("hidden");
            this.setAttribute("aria-expanded", "false");
          }
        });

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((other) => {
            if (other !== dropdown) other.removeAttribute("open");
          });
        });
      });

      document.addEventListener("pointerdown", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.removeAttribute("open");
        });
        if (mobileMenu && hamburger && !mobileMenu.classList.contains("hidden") && !mobileMenu.contains(target) && !hamburger.contains(target)) {
          mobileMenu.classList.add("hidden");
          hamburger.setAttribute("aria-expanded", "false");
        }
      });
    </script>
  </body>
</html>
