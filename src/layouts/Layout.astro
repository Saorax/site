---
import "../styles/global.css";
export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWide?: boolean;
  canonical?: string;
  noindex?: boolean;
  footer?: boolean;
}

const { title, description, image, imageAlt, imageWide = false, canonical, noindex = false, footer = true } = Astro.props as Props;

import { navLinks, sectionByKey, externalLinks, moreLinks, siteLinks as siteTools } from "../data/sections.js";
import SiteSearch from "../components/ui/SiteSearch.jsx";
import { DEFAULT_DESCRIPTION, DEFAULT_IMAGE, SITE_URL, absoluteUrl, clipDescription, pageTitle } from "../data/head.js";

const documentTitle = pageTitle(title);
const metaDescription = clipDescription(description || DEFAULT_DESCRIPTION);
const pageUrl = absoluteUrl(canonical ?? `${Astro.url.pathname}${Astro.url.search}`, SITE_URL);
const shareImage = absoluteUrl(image || DEFAULT_IMAGE, SITE_URL);
const largeImage = Boolean(image) && imageWide;

const gameLinks = navLinks("game");
const competitiveLinks = navLinks("competitive");
const bifrostLinks = navLinks("bifrost");
const rankedSection = sectionByKey("ranked");
const rankedLinks = navLinks("ranked");
const siteLinks = siteTools.map((tool) => ({ label: tool.title, href: tool.href }));
const outLinks = externalLinks.map((link) => ({ label: `${link.title} ↗︎`, href: link.href }));
const menuOutLinks = [...externalLinks, ...moreLinks].map((link) => ({ label: `${link.title} ↗︎`, href: link.href }));
const footerLinks = [{ label: "Home", href: "/" }, ...["game", "competitive", "ranked", "bifrost"].map((key) => sectionByKey(key)).map((section) => ({ label: section.title, href: section.href })), ...siteLinks];
const homeActive = Astro.url.pathname === "/";
const gameActive = Astro.url.pathname.startsWith("/game");
const competitiveActive = Astro.url.pathname.startsWith("/pr") || Astro.url.pathname.startsWith("/esports");
const bifrostActive = Astro.url.pathname.startsWith("/bifrost");
const rankedActive = Astro.url.pathname.startsWith("/raybot");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/asuri.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#3b82f6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Brawlhalla Database" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={largeImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={shareImage} />
    <style>
      .svg-container {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .svg-container svg {
        max-width: 100%;
        max-height: 100%;
      }
    </style>
  </head>
  <body class="min-h-screen bg-gray-100 text-slate-950 dark:bg-slate-950 dark:text-white">
  <nav class="sticky top-0 z-[100] select-none [@media(max-height:500px)]:static border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
    <div class="px-2 sm:px-3">
      <div class="relative flex h-16 items-center justify-between gap-3">
        <div class="flex items-center sm:hidden">
          <button
            id="hamburger-button"
            type="button"
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-slate-100 p-2 text-slate-600 hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <svg
              class="block h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="hidden h-6 w-6"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="flex min-w-0 flex-1 items-center justify-center sm:justify-start">
          <a href="/" class="flex items-center gap-2 rounded-xl px-2 py-1 text-slate-950 transition hover:bg-slate-100 dark:text-white dark:hover:bg-slate-900">
            <img class="h-9 w-9 object-contain" src="/asuri.png" alt="Saorax" />
            <span class="hidden text-base font-black sm:block">Saorax</span>
          </a>
          <div class="ml-3 hidden items-center gap-1 sm:flex">
            <a href="/" class:list={["rounded-xl px-3 py-2 text-sm font-black transition", homeActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Home</a>
            <details class="group relative">
              <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black transition marker:hidden", gameActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Game</summary>
              <div class="absolute left-0 top-full mt-2 grid w-64 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {gameLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
            <details class="group relative">
              <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black transition marker:hidden", competitiveActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Competitive</summary>
              <div class="absolute left-0 top-full mt-2 grid w-56 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {competitiveLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
            {rankedLinks.length > 1 ? (
              <details class="group relative">
                <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black transition marker:hidden", rankedActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>{rankedSection.title}</summary>
                <div class="absolute left-0 top-full mt-2 grid w-56 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                  {rankedLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
                </div>
              </details>
            ) : (
              <a href={rankedSection.href} class:list={["rounded-xl px-3 py-2 text-sm font-black transition", rankedActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>{rankedSection.title}</a>
            )}
            <details class="group relative">
              <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black transition marker:hidden", bifrostActive ? "bg-blue-500 text-white" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900"]}>Bifrost</summary>
              <div class="absolute left-0 top-full mt-2 grid w-48 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {bifrostLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
            <details class="group relative">
              <summary class="flex cursor-pointer list-none items-center gap-1 rounded-xl px-3 py-2 text-sm font-black text-slate-700 transition marker:hidden hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-900">More</summary>
              <div class="absolute left-0 top-full mt-2 grid w-48 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
                {siteLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
                {menuOutLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer" class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 hover:bg-blue-500 hover:text-white dark:text-slate-200">{link.label}</a>)}
              </div>
            </details>
          </div>
        </div>
        <SiteSearch client:idle />
      </div>
    </div>
  </nav>
  <div class="hidden select-none border-b border-slate-200 bg-white shadow-lg dark:border-slate-800 dark:bg-slate-950 sm:hidden" id="mobile-menu">
    <div class="grid gap-2 p-3">
      <a href="/" class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-800 dark:bg-slate-900 dark:text-white">Home</a>
      <details class="rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer list-none px-3 py-2 text-sm font-black marker:hidden">Game</summary>
        <div class="grid gap-1 border-t border-slate-200 p-2 dark:border-slate-800">{gameLinks.map((link) => <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-blue-500 hover:text-white">{link.label}</a>)}</div>
      </details>
      <details class="rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer list-none px-3 py-2 text-sm font-black marker:hidden">Competitive</summary>
        <div class="grid gap-1 border-t border-slate-200 p-2 dark:border-slate-800">{competitiveLinks.map((link) => <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-blue-500 hover:text-white">{link.label}</a>)}</div>
      </details>
      {rankedLinks.length > 1 ? (
        <details class="rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer list-none px-3 py-2 text-sm font-black marker:hidden">{rankedSection.title}</summary>
          <div class="grid gap-1 border-t border-slate-200 p-2 dark:border-slate-800">{rankedLinks.map((link) => <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-blue-500 hover:text-white">{link.label}</a>)}</div>
        </details>
      ) : (
        <a href={rankedSection.href} class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-800 dark:bg-slate-900 dark:text-white">{rankedSection.title}</a>
      )}
      <details class="rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer list-none px-3 py-2 text-sm font-black marker:hidden">Bifrost</summary>
        <div class="grid gap-1 border-t border-slate-200 p-2 dark:border-slate-800">{bifrostLinks.map((link) => <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-blue-500 hover:text-white">{link.label}</a>)}</div>
      </details>
      {siteLinks.map((link) => <a href={link.href} class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-800 dark:bg-slate-900 dark:text-white">{link.label}</a>)}
      {menuOutLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer" class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-800 dark:bg-slate-900 dark:text-white">{link.label}</a>)}
    </div>
  </div>
    <main class="min-h-[calc(100dvh-4rem-1px)] bg-gray-100 text-slate-950 dark:bg-slate-950 dark:text-white">
      <slot />
    </main>
    {footer && (
      <footer class="border-t border-slate-200 bg-white px-2 py-3 text-sm dark:border-slate-800 dark:bg-slate-950 sm:px-3">
        <nav aria-label="Footer" class="flex flex-wrap items-center gap-1">
          {footerLinks.map((link) => <a href={link.href} class="rounded-lg px-2 py-1 font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-white">{link.label}</a>)}
          {outLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer" class="rounded-lg px-2 py-1 font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-white">{link.label}</a>)}
        </nav>
      </footer>
    )}
    <script>
      const hamburger = document.getElementById("hamburger-button");
      const mobileMenu = document.getElementById("mobile-menu");
      const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>("nav details, #mobile-menu details"));

      const setMenuOpen = (open: boolean) => {
        if (!mobileMenu || !hamburger) return;
        mobileMenu.classList.toggle("hidden", !open);
        hamburger.setAttribute("aria-expanded", open ? "true" : "false");
        const icons = hamburger.querySelectorAll("svg");
        icons[0]?.classList.toggle("hidden", open);
        icons[0]?.classList.toggle("block", !open);
        icons[1]?.classList.toggle("hidden", !open);
        icons[1]?.classList.toggle("block", open);
      };

      hamburger?.addEventListener("click", () => {
        setMenuOpen(Boolean(mobileMenu?.classList.contains("hidden")));
      });

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((other) => {
            if (other !== dropdown) other.removeAttribute("open");
          });
        });
      });

      document.addEventListener("pointerdown", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.removeAttribute("open");
        });
        if (mobileMenu && hamburger && !mobileMenu.classList.contains("hidden") && !mobileMenu.contains(target) && !hamburger.contains(target)) {
          setMenuOpen(false);
        }
      });
    </script>
  </body>
</html>
